# Text model for chat.py and tests with a real model.
# Format: <provider>:<model>. Examples: anthropic:claude-opus-5-5, openai:gpt-5.5, google_genai:gemini-3.8-pro
LLM_MODEL=anthropic:claude-opus-5-5
# Writes the short call summary at hangup, so a returning caller is recognised next time.
SUMMARY_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Your name, as the agents say it aloud.
OWNER_NAME=
# Optional. How to say your name, in plain words. The voice models take no phonetic markup.
# Example: Lovelace is said "LUV-layss", in two parts.
OWNER_NAME_PRONUNCIATION=
# Optional. A brand you work under. The greeting then says "<brand>, <your name>'s AI business card".
BRAND_NAME=

# Where the human path transfers the call. E.164 format.
OWNER_PHONE=+15555550100

# Facts about the owner. The only source for claims the agents make about you.
PROFILE_PATH=profile.md
LEADS_DB=data/leads.sqlite3

# Lead emails. When a caller confirms their details, the owner gets them by email.
# The agents never see OWNER_EMAIL. Leave SMTP_HOST empty to record emails without sending.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an app password (not your normal password).
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The From address. Defaults to SMTP_USERNAME.
SMTP_FROM=

# Telnyx. Run `bash scripts/telnyx-setup.sh` to fill these in.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_APP_ID=

# Guardrails for a public number. 0 turns a limit off.
# The call ends at MAX_CALL_MINUTES; the agent warns the caller one minute before.
MAX_CALL_MINUTES=10
# Calls from one number in 24 hours. OWNER_PHONE is exempt.
MAX_CALLS_PER_NUMBER_PER_DAY=5
MAX_CONCURRENT_CALLS=3
# Total call minutes in 24 hours, all callers together. This bounds the daily model cost.
DAILY_MINUTES_CAP=120
# A live transfer to OWNER_PHONE is offered only in these hours, US Eastern. Outside them the agent
# takes a message. Empty TRANSFER_HOURS = any time.
TRANSFER_HOURS=09:00-18:00
TRANSFER_DAYS=mon-fri
# How long the owner's phone rings. After that the contact agent comes back to the caller.
# A live transfer also needs an outbound voice profile on the Telnyx application: uv run setup-transfer
TRANSFER_RING_SECS=25
# Jev, the decision model of TypeSafe AI. Before a live transfer, the server checks that the
# caller asked for one. With a key, Jev reads the caller's words for their meaning and gives the
# probability of a yes. Empty = a word list decides alone; it reads words, not meaning.
# Make a key at console.typesafe.ai, then run: uv run check-jev
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# After this many milliseconds Jev gives no decision, and the word list decides. Set it from the times check-jev prints.
# JEV_TIMEOUT_MS=500
# When a voice provider (OpenAI or Google) stops answering, the call moves to the other one.
# When neither answers, a built-in Telnyx voice apologises. Then it transfers the caller to
# OWNER_PHONE, inside the transfer hours. Set false to ask the caller to call again instead.
TRANSFER_ON_FAILURE=true

# Text messages. Needs a Telnyx messaging profile on the number and a registered 10DLC campaign;
# US carriers block texts from unregistered numbers. When on, agents can text PORTFOLIO_URL to a caller
# who asks for it, and the owner gets a text just before a live transfer.
SMS_ENABLED=false
PORTFOLIO_URL=

# Optional. Your public website. Every agent says it when a caller asks, and the goodbye line names it.
# A part of the name that equals BRAND_NAME without spaces is said as the brand's words ("digital reformer dot dev").
WEBSITE_URL=

# Optional. An RSS feed of your published writing. The profile agent searches it with RAG: a local
# embedding model and BM25 over short passages. The server reads the feed at start and keeps a copy.
WRITING_FEED_URL=
# The local embedding model (fastembed). Empty = keyword search only.
WRITING_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Look up each new caller's carrier, line type, area, and registered name. Telnyx bills each lookup;
# results are cached, so a number is looked up once. Values: off, carrier, carrier+name.
CALLER_LOOKUP=carrier+name

# Public HTTPS URL of this server. With Tailscale Funnel: https://<node>.<tailnet>.ts.net
# (run `tailscale funnel --bg 8000`). ngrok works too. The M2 server sets the Telnyx webhook URL from it.
PUBLIC_URL=
# The address the server listens on. Leave it out on a laptop. The container image sets 0.0.0.0.
# HOST=127.0.0.1

# Save the caller's side of each call to data/caller_audio/ as a WAV file. For tests of noise and coughs.
# It puts callers' voices on this disk, so it is off by default.
SAVE_CALLER_AUDIO=false

# OpenAI Realtime voice leg.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Turn detection: how fast the agent answers after the caller stops talking.
# server = fixed silence timer (fastest). semantic = the model judges whether the caller is done.
OPENAI_TURN_DETECTION=server
OPENAI_VAD_SILENCE_MS=400
OPENAI_VAD_THRESHOLD=0.8
# near_field for a handset at the ear; far_field for a speakerphone.
OPENAI_NOISE_REDUCTION=near_field
OPENAI_VAD_EAGERNESS=high

# One loudness for every agent voice, in dBFS. Without it a Gemini voice can be 10 dB louder
# than an OpenAI voice. 0 turns the leveler off.
VOICE_LEVEL_DBFS=-22

# Gemini Live voice leg (the profile and consultant agents). Needs GOOGLE_API_KEY above;
# without it those agents run on OpenAI.
GEMINI_LIVE_MODEL=models/gemini-3.8-live
GEMINI_VAD_SILENCE_MS=400
# low ignores more background noise; high hears quiet speech sooner.
GEMINI_VAD_START_SENSITIVITY=low

# Amazon Nova Sonic voice leg, on Amazon Bedrock. Optional. Without the two keys, an agent set
# to nova_sonic runs on another provider. The names start with NOVA_ so that AWS_ variables in
# your shell, which can belong to another AWS account, are never used for calls.
# The IAM user needs one permission: bedrock:InvokeModelWithBidirectionalStream.
# Check the settings with: uv run check-nova
NOVA_AWS_ACCESS_KEY_ID=
NOVA_AWS_SECRET_ACCESS_KEY=
NOVA_AWS_REGION=us-east-1
NOVA_SONIC_MODEL=amazon.nova-2-5-sonic
# How fast Nova decides the caller has stopped talking: LOW, MEDIUM, or HIGH (fastest).
NOVA_ENDPOINTING=HIGH

# Move agents to another voice leg: agent=leg pairs with commas between them.
# Legs: openai_realtime, gemini_live, nova_sonic. Empty = the defaults.
# Example: AGENT_LEGS=consultant=nova_sonic
AGENT_LEGS=

# The server writes everything it prints to this file too. The file of the run before is kept
# as data/server.log.previous. Empty = no file.
SERVER_LOG=data/server.log

# Call screening on a live transfer. The server calls the owner as a separate call. The caller
# hears a ring tone and never hears the owner's phone or voicemail. A voice tells the owner who
# is calling. Key 1 connects the caller. Key 2, or no key, brings the contact agent back.
# Needs TELNYX_APP_ID and PUBLIC_URL. With false, the server uses the plain Telnyx transfer.
TRANSFER_SCREENING=true
# Seconds the owner has to press a key after the question. The question is asked twice.
TRANSFER_ACCEPT_SECS=6
# What the caller hears while they wait: the URL of a WAV or MP3 file, for example hold music.
# Empty = a ring tone that this server makes and serves at /audio/ringback.wav.
TRANSFER_HOLD_AUDIO_URL=

# The owner's voicemail answers a transfer like a person does. With true, Telnyx listens after
# the answer; when it hears a machine, the server hangs up that leg and the agent comes back.
TRANSFER_VOICEMAIL_DETECTION=true

# LangSmith tracing: each call is one thread with its turns, words, tool calls and timing.
# Off unless both lines below are set. Make a key at smith.langchain.com. Call text is sent in
# full; no audio is sent. An agent-based LangSmith workspace uses LANGSMITH_AGENT_ID and
# LANGSMITH_AGENT_ENVIRONMENT instead of LANGSMITH_PROJECT.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voice-business-card
