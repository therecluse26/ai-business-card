# Text model for chat.py, tests with a real model, and the M7 pipeline leg.
# Format: <provider>:<model>. Examples: anthropic:claude-opus-5-5, openai:gpt-5.5, google_genai:gemini-3.8-pro
LLM_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Your name, as the agents say it aloud.
OWNER_NAME=

# Where the human path transfers the call. E.164 format.
OWNER_PHONE=+15555550100

# Facts about the owner. The only source for claims the agents make about you.
PROFILE_PATH=profile.md
LEADS_DB=data/leads.sqlite3

# Lead emails. When a caller confirms their details, the owner gets them by email.
# The agents never see OWNER_EMAIL. Leave SMTP_HOST empty to record emails without sending.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an app password (not your normal password).
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# The From address. Defaults to SMTP_USERNAME.
SMTP_FROM=

# Telnyx. Run `bash scripts/telnyx-setup.sh` to fill these in.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_APP_ID=

# Public HTTPS URL of this server. With Tailscale Funnel: https://<node>.<tailnet>.ts.net
# (run `tailscale funnel --bg 8000`). ngrok works too. The M2 server sets the Telnyx webhook URL from it.
PUBLIC_URL=

# OpenAI Realtime voice leg.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Turn detection: how fast the agent answers after the caller stops talking.
# server = fixed silence timer (fastest). semantic = the model judges whether the caller is done.
OPENAI_TURN_DETECTION=server
OPENAI_VAD_SILENCE_MS=400
OPENAI_VAD_THRESHOLD=0.6
# near_field for a handset at the ear; far_field for a speakerphone.
OPENAI_NOISE_REDUCTION=near_field
OPENAI_VAD_EAGERNESS=high
